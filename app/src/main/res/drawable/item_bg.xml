<?xml version="1.0" encoding="utf-8"?>
<!-- Строка списка: под фокусом пульта — светлая, играющий канал — с тёплой подложкой -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="90" android:exitFadeDuration="90">
    <item android:state_focused="true">
        <shape><solid android:color="@color/focus"/><corners android:radius="14dp"/></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="@color/focus"/><corners android:radius="14dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#1FFFFFFF"/><corners android:radius="14dp"/></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="@color/accent_dim"/><corners android:radius="14dp"/></shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent"/><corners android:radius="14dp"/></shape></item>
</selector>
