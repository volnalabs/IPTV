<?xml version="1.0" encoding="utf-8"?>
<!-- Плитка под логотипом. Под светлым фокусом остаётся тёмной: логотипы обычно нарисованы для тёмного фона. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#1B1D23"/><corners android:radius="11dp"/></shape>
    </item>
    <item android:state_selected="true">
        <shape><solid android:color="#1B1D23"/><corners android:radius="11dp"/></shape>
    </item>
    <item><shape><solid android:color="#12FFFFFF"/><corners android:radius="11dp"/></shape></item>
</selector>
