<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:resize_mode="fit"
        app:shutter_background_color="#000000"
        app:surface_type="surface_view" />

    <com.volnalabs.tv.ui.LoadingView
        android:id="@+id/loading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:maxWidth="640dp"
        android:background="@drawable/message_bg"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="28dp"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Нижняя плашка: что сейчас идёт -->
    <LinearLayout
        android:id="@+id/infoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/info_bg"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="64dp"
        android:paddingTop="140dp"
        android:paddingEnd="64dp"
        android:paddingBottom="44dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="66dp"
            android:layout_marginBottom="34dp"
            android:background="@drawable/logo_bg"
            android:padding="10dp">

            <ImageView
                android:id="@+id/infoLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/infoNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text3"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/infoName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text2"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/infoBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/badge_archive"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/archive"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/infoClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:textColor="@color/text"
                    android:textSize="26sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/infoNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="32sp" />

            <LinearLayout
                android:id="@+id/infoTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/infoStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text2"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/infoProgress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_bar" />

                <TextView
                    android:id="@+id/infoEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text2"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/infoNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text3"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ввод номера канала цифрами -->
    <TextView
        android:id="@+id/numberInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="40dp"
        android:background="@drawable/chip_bg"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text"
        android:textSize="44sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Левая панель. По умолчанию видна только колонка каналов:
         группы выезжают по ◀, телепрограмма — по ▶ -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/panel_scrim"
        android:orientation="horizontal"
        android:padding="20dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/groupsColumn"
            android:layout_width="264dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="@drawable/column2_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/ColumnTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:text="Группы" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/groups"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="32dp"
                android:scrollbars="none" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/channelsColumn"
            android:layout_width="440dp"
            android:layout_height="match_parent"
            android:background="@drawable/column_bg"
            android:orientation="vertical">

            <TextView
                android:id="@+id/channelsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingStart="28dp"
                android:paddingTop="26dp"
                android:paddingEnd="28dp"
                android:textColor="@color/text"
                android:textSize="24sp" />

            <!-- Поле поиска: появляется вместо заголовка, когда выбран «Поиск» -->
            <LinearLayout
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/search_bg"
                android:addStatesFromChildren="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text2" />

                <EditText
                    android:id="@+id/searchField"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Название канала"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text|textNoSuggestions"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text3"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/channelsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:paddingTop="2dp"
                android:paddingEnd="28dp"
                android:paddingBottom="14dp"
                android:textColor="@color/text3"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channels"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="32dp"
                android:scrollbars="none" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/epgColumn"
            android:layout_width="424dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:background="@drawable/column2_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/epgTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingStart="28dp"
                android:paddingTop="26dp"
                android:paddingEnd="28dp"
                android:textColor="@color/text"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/epgHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:paddingTop="2dp"
                android:paddingEnd="28dp"
                android:paddingBottom="6dp"
                android:text="Телепрограмма"
                android:textColor="@color/text3"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/epgEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:paddingTop="16dp"
                android:paddingEnd="28dp"
                android:textColor="@color/text3"
                android:textSize="15sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/programmes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="32dp"
                android:scrollbars="none" />
        </LinearLayout>
    </LinearLayout>

    <!-- Заставка при запуске -->
    <com.volnalabs.tv.ui.SplashView
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true" />

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="32dp"
        android:background="@drawable/chip_bg"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:visibility="gone" />
</FrameLayout>
