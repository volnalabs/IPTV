<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:resize_mode="fit"
        app:shutter_background_color="#000000"
        app:surface_type="surface_view" />

    <com.volnalabs.tv.ui.LoadingView
        android:id="@+id/loading"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:maxWidth="640dp"
        android:background="@drawable/message_bg"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="28dp"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Плашка внизу: что сейчас идёт и какие кнопки пульта что делают -->
    <LinearLayout
        android:id="@+id/infoBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="22dp"
        android:background="@drawable/info_bg"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="92dp"
                android:layout_height="69dp"
                android:background="@drawable/logo_bg"
                android:padding="9dp">

                <ImageView
                    android:id="@+id/infoLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/infoNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="9dp"
                        android:background="@drawable/badge_number"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="8dp"
                        android:paddingTop="1dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="1dp"
                        android:textColor="@color/text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/infoName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/text2"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/infoBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/badge_archive"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:paddingStart="9dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="2dp"
                        android:textColor="@color/archive"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/infoClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/text"
                        android:textSize="26sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/infoNow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="28sp" />

                <LinearLayout
                    android:id="@+id/infoTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/infoStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text2"
                        android:textSize="13sp" />

                    <ProgressBar
                        android:id="@+id/infoProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progressDrawable="@drawable/progress_bar" />

                    <TextView
                        android:id="@+id/infoEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text2"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/infoNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text3"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/infoDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/divider" />

        <LinearLayout
            android:id="@+id/infoHints"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Гид. На телевизоре — три колонки сразу: разделы, каналы, программа, внизу подсказки.
         На сенсорном экране — одна карточка с вкладками «Каналы» и «Программа». -->
    <FrameLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/panel_scrim"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Шапка для сенсорного экрана (на телевизоре скрыта) -->
            <LinearLayout
                android:id="@+id/touchBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tabChannels"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/button_bg"
                    android:clickable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Каналы"
                    android:textColor="@color/text_button"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tabEpg"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/button_bg"
                    android:clickable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Программа"
                    android:textColor="@color/text_button"
                    android:textSize="14sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/touchLive"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/button_primary_bg"
                    android:clickable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="В эфир"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/touchSearch"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/icon_button_bg"
                    android:clickable="true"
                    android:contentDescription="Поиск"
                    android:padding="10dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/text" />

                <ImageView
                    android:id="@+id/touchSettings"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/icon_button_bg"
                    android:clickable="true"
                    android:contentDescription="Настройки"
                    android:padding="10dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/columns"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- Разделы: поиск, избранное, группы; внизу закреплены настройки и плагины -->
                <LinearLayout
                    android:id="@+id/groupsColumn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="23"
                    android:background="@drawable/column_bg"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">

                        <View
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/brand_mark" />

                        <TextView
                            android:id="@+id/groupsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.2"
                            android:text="IPTV"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/panelClock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-light"
                            android:textColor="@color/text2"
                            android:textSize="19sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/groups"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:fadingEdgeLength="20dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp"
                        android:requiresFadingEdge="vertical"
                        android:scrollbars="none" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="8dp">

                        <LinearLayout
                            android:id="@+id/settingsRow"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/item_bg"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="12dp"
                                android:duplicateParentState="true"
                                android:src="@drawable/ic_settings"
                                android:tint="@color/icon_main" />

                            <TextView
                                android:id="@+id/name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:duplicateParentState="true"
                                android:text="Настройки"
                                android:textColor="@color/text_main"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/pluginsRow"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/item_bg"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginEnd="12dp"
                                android:duplicateParentState="true"
                                android:src="@drawable/ic_plug"
                                android:tint="@color/icon_main" />

                            <TextView
                                android:id="@id/name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:duplicateParentState="true"
                                android:text="Плагины"
                                android:textColor="@color/text_main"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/channelsColumn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="42"
                    android:background="@drawable/column_bg"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/channelsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:id="@+id/channelsTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/text"
                            android:textSize="22sp" />

                        <!-- Поле поиска: появляется вместо заголовка, когда выбран «Поиск» -->
                        <LinearLayout
                            android:id="@+id/searchBox"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="-6dp"
                            android:layout_weight="1"
                            android:addStatesFromChildren="true"
                            android:background="@drawable/search_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_search"
                                android:tint="@color/text2" />

                            <EditText
                                android:id="@+id/searchField"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="Название или номер канала"
                                android:imeOptions="actionSearch|flagNoExtractUi"
                                android:inputType="text|textNoSuggestions"
                                android:singleLine="true"
                                android:textColor="@color/text"
                                android:textColorHint="@color/text3"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/channelsHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/badge_number"
                            android:maxLines="1"
                            android:paddingStart="9dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="2dp"
                            android:textColor="@color/text2"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Группы «таблетками» — только на сенсорном экране -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="4dp"
                        android:paddingBottom="8dp"
                        android:scrollbars="none"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/channelsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:paddingStart="24dp"
                        android:paddingTop="28dp"
                        android:paddingEnd="24dp"
                        android:textColor="@color/text3"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/channels"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:fadingEdgeLength="20dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="16dp"
                        android:requiresFadingEdge="vertical"
                        android:scrollbars="none" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/epgColumn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="35"
                    android:background="@drawable/column2_bg"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/logo_bg"
                            android:padding="4dp">

                            <ImageView
                                android:id="@+id/epgLogo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitCenter" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/epgTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:textColor="@color/text"
                                android:textSize="17sp" />

                            <TextView
                                android:id="@+id/epgHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Телепрограмма"
                                android:textColor="@color/text3"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/epgEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:paddingStart="24dp"
                        android:paddingTop="28dp"
                        android:paddingEnd="24dp"
                        android:textColor="@color/text3"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/programmes"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:fadingEdgeLength="20dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="16dp"
                        android:requiresFadingEdge="vertical"
                        android:scrollbars="none" />
                </LinearLayout>
            </LinearLayout>

            <!-- Подсказки по кнопкам пульта: меняются вместе с колонкой, в которой фокус -->
            <LinearLayout
                android:id="@+id/hintBar"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Номер канала цифрами: набранное число и каналы, которые под него подходят -->
    <LinearLayout
        android:id="@+id/numberPad"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/pad_bg"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                style="@style/SectionTitle"
                android:text="Канал" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/numberInput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:textColor="@color/text"
                android:textSize="44sp" />

            <View
                android:layout_width="3dp"
                android:layout_height="36dp"
                android:layout_marginStart="5dp"
                android:background="@color/accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/numberList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/numberNone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text2"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/numberTimer"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_bar" />

        <LinearLayout
            android:id="@+id/numberHints"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp" />
    </LinearLayout>

    <!-- Заставка при запуске -->
    <com.volnalabs.tv.ui.SplashView
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:clickable="true" />

    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
