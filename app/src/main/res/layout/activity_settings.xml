<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">
<LinearLayout
        android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="24dp"
    android:paddingEnd="48dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Настройки"
        android:textColor="@color/text"
        android:textSize="26sp" />

    <!-- Плейлист + ввод с телефона -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/card_bg"
        android:orientation="horizontal"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SectionTitle"
                android:text="Плейлист" />

            <EditText
                android:id="@+id/playlistUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/input_bg"
                android:hint="Ссылка на плейлист (M3U)"
                android:imeOptions="actionNext|flagNoExtractUi"
                android:inputType="textUri"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text3"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/epgUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_bg"
                android:hint="Телепрограмма — необязательно"
                android:imeOptions="actionDone|flagNoExtractUi"
                android:inputType="textUri"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text3"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/save"
                    style="@style/PillButton"
                    android:background="@drawable/button_primary_bg"
                    android:text="Сохранить" />

                <Button
                    android:id="@+id/refresh"
                    style="@style/PillButton"
                    android:layout_marginStart="10dp"
                    android:text="Обновить каналы" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/playlistStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:maxLines="1"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/epgStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="0dp"
                    android:maxLines="1"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
        android:id="@+id/qrDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="22dp"
            android:background="@color/divider" />

        <LinearLayout
        android:id="@+id/qrBox"
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_phone"
                    android:tint="@color/text2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Вставить с телефона"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="116dp"
                android:layout_height="116dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/qr_bg"
                android:padding="7dp">

                <ImageView
                    android:id="@+id/qr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                android:id="@+id/remoteUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Наведите камеру на код"
                android:textColor="@color/text3"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Приложение -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="18dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <TextView
            style="@style/SectionTitle"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="6dp"
            android:text="Приложение" />

        <LinearLayout
        android:id="@+id/appRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/autoUpdateRow"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/item_bg"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_refresh"
                        android:tint="@color/text_sub" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Обновлять автоматически"
                        android:textColor="@color/text_main"
                        android:textSize="15sp" />

                    <com.volnalabs.tv.ui.ToggleView
                        android:id="@+id/autoUpdateToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/checkUpdate"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/item_bg"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_search"
                        android:tint="@color/text_sub" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Проверить обновления"
                        android:textColor="@color/text_main"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/updateStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:textColor="@color/text2"
                        android:textSize="13sp" />
                </LinearLayout>
        </LinearLayout>

        <LinearLayout
        android:id="@+id/appRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/volumeRow"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/item_bg"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_volume"
                        android:tint="@color/text_sub" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Запоминать громкость"
                        android:textColor="@color/text_main"
                        android:textSize="15sp" />

                    <com.volnalabs.tv.ui.ToggleView
                        android:id="@+id/volumeToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fillRow"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/item_bg"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_expand"
                        android:tint="@color/text_sub" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:duplicateParentState="true"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Убирать чёрные полосы"
                        android:textColor="@color/text_main"
                        android:textSize="15sp" />

                    <com.volnalabs.tv.ui.ToggleView
                        android:id="@+id/fillToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</ScrollView>
