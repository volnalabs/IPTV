<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:fontFamily">@font/onest</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="DialogTheme" parent="AppTheme">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text3</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">@font/onest_medium</item>
    </style>
    <style name="ColumnTitle">
        <item name="android:textColor">@color/text3</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:fontFamily">@font/onest_medium</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">36dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="PillButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/button_bg</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_button</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/onest_medium</item>
        <item name="android:minWidth">0dp</item>
    </style>
</resources>
